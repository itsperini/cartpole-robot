<mujoco model="cartpole swingup">
  <compiler angle="radian" inertiafromgeom="true"/>

  <option gravity="0 0 -9.81" integrator="RK4" timestep="0.02"/>

  <default>
    <joint armature="0" damping="0.02" limited="false"/>
    <geom conaffinity="0" contype="0" friction="1 0.1 0.1" rgba="0.7 0.7 0.7 1"/>
  </default>

  <worldbody>
    <light diffuse="0.8 0.8 0.8" dir="0 0 -1" pos="0 0 4"/>
    <camera name="track" mode="trackcom" pos="0 -4 1.2" xyaxes="1 0 0 0 0.25 1"/>

    <geom name="rail" type="capsule" fromto="-2.5 0 0 2.5 0 0" size="0.02" rgba="0.3 0.3 0.8 1"/>

    <body name="cart" pos="0 0 0">
      <joint axis="1 0 0" damping="0.1" limited="true" name="slider" range="-2.4 2.4" type="slide"/>
      <geom name="cart" type="box" mass="1.0" pos="0 0 0.04" size="0.16 0.09 0.06" rgba="0.85 0.2 0.2 1"/>

      <body name="pole" pos="0 0 0.08">
        <joint axis="0 1 0" damping="0.01" limited="false" name="hinge" type="hinge"/>
        <geom name="pole" type="capsule" fromto="0 0 0 0 0 0.7" mass="0.12" size="0.025" rgba="0.1 0.75 0.65 1"/>
        <site name="tip" pos="0 0 0.7" size="0.035" rgba="0.05 0.05 0.05 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor ctrllimited="true" ctrlrange="-10 10" gear="1" joint="slider" name="cart_force"/>
  </actuator>
</mujoco>
